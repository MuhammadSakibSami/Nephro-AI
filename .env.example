# =============================================================================
# BACKEND ENVIRONMENT (template)  —  kidney-risk screening API
# -----------------------------------------------------------------------------
# Copy this file to ".env" (same folder = the repo root) and edit as needed.
# It is loaded automatically when the backend starts (backend/main.py).
# Format: KEY=value  (no quotes needed). Lines starting with "#" are comments.
# =============================================================================


# -----------------------------------------------------------------------------
# CKD_LLM_MODEL  —  which LLM backend the /generate-guidance endpoint uses.
# -----------------------------------------------------------------------------
# Choose ONE value:
#
#   auto         Smart cascade: tries HuggingFace Qwen3 first, then Ollama if
#                it's already running locally, then falls back to local_demo.
#                Good for development machines where you want the best available.
#
#   local_demo   Force LOCAL DEMO mode. No GPU / no ML libraries needed.
#                Guidance is produced by a deterministic safe generator, still
#                passed through the full safety validator, labelled "local demo".
#                Best for supervisor demos and CPU-only machines.
#                (aliases: demo, mock, local)
#
#   ollama       PRODUCTION via Ollama REST API. Runs Qwen3-4B-Instruct-2507
#                locally via Ollama (https://ollama.com). No Python ML stack.
#                Needs ~3 GB VRAM — ideal for laptops with a 4 GB GPU (RTX 3050).
#                One-time setup:
#                  1. Install Ollama from https://ollama.com
#                  2. ollama pull qwen3:4b-instruct-2507-q4_K_M
#                  3. Set CKD_LLM_MODEL=ollama here
#                Model and URL can be overridden with OLLAMA_MODEL / OLLAMA_BASE_URL.
#
#   qwen         PRODUCTION via HuggingFace transformers. Downloads and runs
#                Qwen/Qwen3-4B-Instruct-2507 (~8 GB VRAM). Use in Colab or on a
#                dedicated GPU server. Requires: pip install -r requirements-llm.txt
#                (aliases: production, prod)
#
# Switching between ollama and qwen: change one env var, restart the backend.
# The safety validator, RAG retriever, and all other code stay unchanged.
CKD_LLM_MODEL=local_demo


# -----------------------------------------------------------------------------
# OLLAMA_MODEL  —  model tag used when CKD_LLM_MODEL=ollama (or auto→ollama).
# -----------------------------------------------------------------------------
# Default: qwen3:4b-instruct-2507-q4_K_M  (official Ollama library, Q4_K_M quant)
# Change this to try a different quant or model without editing any Python code.
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M


# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL  —  base URL of the Ollama server.
# -----------------------------------------------------------------------------
# Default: http://localhost:11434  (Ollama's default port)
# Change if you run Ollama on a non-default port or a remote machine.
# OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# CKD_MODEL_PATH  —  path to the trained ML model package (.joblib).
# -----------------------------------------------------------------------------
# Optional. Leave UNSET to use the default bundled location:
#   model_package/joint_s1_rfbalanced_k19_s2_rfbalanced_k12_stage2_thr050_model_package.joblib
# Set a path only if you store the model elsewhere. Example:
#   CKD_MODEL_PATH=./model_package/joint_s1_rfbalanced_k19_s2_rfbalanced_k12_stage2_thr050_model_package.joblib
# CKD_MODEL_PATH=


# -----------------------------------------------------------------------------
# DATABASE_URL  —  PostgreSQL connection for the research dataset.
# -----------------------------------------------------------------------------
# When set, every /predict and /generate-guidance call is saved (patient input
# + ML prediction + LLM guidance) to the `screenings` table.
#
# Leave UNSET to disable persistence entirely — the API still runs and screening
# works; saving is skipped (check GET /db/health). Persistence is best-effort:
# if the database is unreachable, requests still succeed.
#
# PostgreSQL format (recommended for the final research):
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
# Example (local default):
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ckd_research
#
# SQLite (no server needed; handy for quick local testing only):
#   DATABASE_URL=sqlite:///./ckd_local.db
#
# First-time setup: create the database, then either let the app auto-create the
# tables (default, see CKD_DB_AUTO_CREATE) or run migrations:  alembic upgrade head
# DATABASE_URL=

# -----------------------------------------------------------------------------
# CKD_DB_AUTO_CREATE  —  auto-create tables on startup (default: true).
# -----------------------------------------------------------------------------
# true  : on startup the app runs create_all() so tables exist without Alembic.
#         Convenient for the thesis / first run.
# false : you manage the schema with Alembic ("alembic upgrade head"). Use this
#         once you start adding migrations so the two don't diverge.
# CKD_DB_AUTO_CREATE=true


# -----------------------------------------------------------------------------
# GEMINI_API_KEY  —  ONLY for the deferred paper-extension data generation.
# -----------------------------------------------------------------------------
# Not needed for the thesis MVP (the app never calls Gemini at inference).
# Used only by the optional Phase-7 RAFT data-generation scripts. Leave blank.
# GEMINI_API_KEY=
