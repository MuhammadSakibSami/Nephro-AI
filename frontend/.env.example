# =============================================================================
# FRONTEND ENVIRONMENT (template)  —  React + Vite app
# -----------------------------------------------------------------------------
# Copy this file to ".env" (in this frontend/ folder) and adjust if needed.
# Vite only exposes variables that start with "VITE_". After editing .env,
# RESTART `npm run dev` (Vite reads env vars at startup).
# =============================================================================


# -----------------------------------------------------------------------------
# VITE_API_BASE_URL  —  base URL of the FastAPI backend the app calls.
# -----------------------------------------------------------------------------
# Pick the value that matches how you run the backend:
#
#   http://localhost:8000        Backend on the SAME machine (most common).
#   http://127.0.0.1:8000        Same machine; use this if "localhost" misbehaves.
#   http://<server-ip>:8000      Backend on another machine / VM on your network.
#   https://<your-domain>        Backend behind HTTPS / a reverse proxy.
#
# Notes:
#   * No trailing slash needed (the client strips it).
#   * The backend already allows all origins (CORS *), so the dev server works.
VITE_API_BASE_URL=http://localhost:8000
